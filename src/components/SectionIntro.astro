---
interface Props {
  index: string;
  title: string;
  copy: string;
}

const { index, title, copy } = Astro.props;
---

<header class="section-intro">
  <p class="section-index" aria-hidden="true">{index}</p>
  <div>
    <h2>{title}</h2>
    <p>{copy}</p>
  </div>
</header>

<style>
  .section-intro {
    display: grid;
    grid-template-columns: var(--rail-width) minmax(0, 1fr);
    gap: var(--grid-gap);
    align-items: start;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .section-index {
    margin: 0.8rem 0 0;
    color: var(--accent);
    font: 700 0.75rem/1 var(--font-mono);
    letter-spacing: 0.12em;
  }

  h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.7rem, 7vw, 6.5rem);
    font-weight: 630;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  div > p {
    max-width: 44rem;
    margin: 1.5rem 0 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.65;
  }

  @media (max-width: 680px) {
    .section-intro {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .section-index {
      margin: 0;
    }
  }
</style>
