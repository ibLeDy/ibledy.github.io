---
type IconName = "arrow" | "github" | "linkedin" | "mail";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

{
  name === "arrow" && (
    <svg aria-hidden="true" viewBox="0 0 24 24" width={size} height={size}>
      <path d="M5 12h13M13 6l6 6-6 6" />
    </svg>
  )
}
{
  name === "mail" && (
    <svg aria-hidden="true" viewBox="0 0 24 24" width={size} height={size}>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m4 7 8 6 8-6" />
    </svg>
  )
}
{
  name === "github" && (
    <svg aria-hidden="true" viewBox="0 0 24 24" width={size} height={size}>
      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7.4A5.8 5.8 0 0 0 19.3 3 5.4 5.4 0 0 0 19.1 0S17.9-.4 15 1.5a14 14 0 0 0-6 0C6.1-.4 4.9 0 4.9 0a5.4 5.4 0 0 0-.2 3A5.8 5.8 0 0 0 3.2 7.1c0 5.8 3.5 7 6.8 7.4A4.8 4.8 0 0 0 9 18v4" />
      <path d="M9 19c-3 .9-3-1.5-4.2-2" />
    </svg>
  )
}
{
  name === "linkedin" && (
    <svg aria-hidden="true" viewBox="0 0 24 24" width={size} height={size}>
      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" />
      <path d="M2 9h4v12H2z" /><circle cx="4" cy="4" r="2" />
    </svg>
  )
}

<style>
  svg {
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }
</style>
