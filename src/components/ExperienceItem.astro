---
import type { Experience } from "../data/site";

interface Props {
  item: Experience;
}

const { item } = Astro.props;
---

<article class="experience-item">
  <div class="experience-meta">
    <p class="company">{item.company}</p>
    <p class="period">{item.period}</p>
  </div>
  <div class="experience-body">
    <h3>{item.role}</h3>
    <p class="summary">{item.summary}</p>
    <ul>
      {item.highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>
  </div>
</article>

<style>
  .experience-item {
    display: grid;
    grid-template-columns: minmax(10rem, var(--rail-width)) minmax(0, 1fr);
    gap: var(--grid-gap);
    padding: 2.25rem 0 3.5rem;
    border-top: 1px solid var(--line);
  }

  .experience-meta p {
    margin: 0;
  }

  .company {
    color: var(--paper);
    font-weight: 680;
  }

  .period {
    margin-top: 0.45rem !important;
    color: var(--ink-faint);
    font: 500 0.72rem/1.45 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h3 {
    margin: -0.2rem 0 1rem;
    font-size: clamp(1.75rem, 3vw, 2.8rem);
    font-weight: 580;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .summary {
    max-width: 48rem;
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.04rem;
    line-height: 1.65;
  }

  ul {
    display: grid;
    gap: 0.72rem;
    max-width: 50rem;
    margin: 1.6rem 0 0;
    padding: 0;
    color: var(--ink-muted);
    list-style: none;
  }

  li {
    position: relative;
    padding-left: 1.35rem;
    line-height: 1.55;
  }

  li::before {
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 0.4rem;
    height: 1px;
    background: var(--accent);
    content: "";
  }

  @media (max-width: 680px) {
    .experience-item {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-bottom: 3rem;
    }
  }
</style>
