---
import Icon from "./Icon.astro";
import type { Project } from "../data/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  <div class="project-topline">
    <span>{project.index}</span>
    <ul aria-label={`${project.name} technologies`}>
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
  <div class="project-main">
    <div>
      <h3>{project.name}</h3>
      <p class="strapline">{project.strapline}</p>
    </div>
    <p class="description">{project.description}</p>
  </div>
  <a href={project.href} target="_blank" rel="noreferrer">
    <span>{project.linkLabel}</span>
    <Icon name="arrow" />
  </a>
</article>

<style>
  .project-card {
    display: flex;
    min-height: 32rem;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.35rem);
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 1.25rem;
    background:
      linear-gradient(135deg, rgb(202 245 98 / 7%), transparent 42%),
      var(--surface);
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }

  .project-card:nth-child(2) {
    background:
      linear-gradient(135deg, rgb(255 132 94 / 8%), transparent 42%),
      var(--surface);
  }

  .project-card:hover {
    border-color: rgb(202 245 98 / 45%);
    transform: translateY(-0.25rem);
  }

  .project-topline {
    display: flex;
    min-height: 3rem;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-faint);
    font: 600 0.68rem/1.4 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    padding: clamp(3rem, 8vw, 7rem) 0 3rem;
  }

  h3 {
    margin: 0;
    font-size: clamp(2.7rem, 5vw, 4.8rem);
    font-weight: 620;
    letter-spacing: -0.065em;
    line-height: 0.92;
  }

  .strapline {
    max-width: 28rem;
    margin: 1.2rem 0 0;
    color: var(--accent);
    font: 600 0.78rem/1.5 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .description {
    max-width: 37rem;
    margin: 0;
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--paper);
    font-weight: 650;
    text-decoration: none;
  }

  a :global(svg) {
    transition: transform 180ms ease;
  }

  a:hover :global(svg) {
    transform: translateX(0.3rem);
  }

  @media (max-width: 680px) {
    .project-card {
      min-height: 0;
    }

    .project-topline {
      display: block;
    }

    ul {
      justify-content: flex-start;
      margin-top: 0.8rem;
    }

    .project-main {
      padding-top: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    a :global(svg) {
      transition: none;
    }

    .project-card:hover {
      transform: none;
    }
  }
</style>
